# ────────────────────────────────────────────
# Frontend Bank — Variables de Entorno
# ────────────────────────────────────────────
# ⚠️  ATENCIÓN: Angular compila en build-time, no runtime.
#     Para cambiar estas variables, modifica los archivos en:
#       src/environments/environment.ts      (desarrollo)
#       src/environments/environment.prod.ts (producción)
#
#     Este archivo es SOLO documentación de las variables disponibles
#     y ejemplo para CI/CD. No lo usa Angular directamente.
# ────────────────────────────────────────────

# URL base del backend API
# Desarrollo: http://localhost:3002
# Producción: https://api.bankapp.com
NG_APP_API_URL=http://localhost:3002

# Prefijo de ruta de la API
NG_APP_API_PREFIX=/bp

# Nombre de la aplicación
NG_APP_NAME=Frontend Bank

# Timeout HTTP en milisegundos
NG_APP_HTTP_TIMEOUT=30000

# Idioma por defecto
NG_APP_DEFAULT_LANGUAGE=es

# Versión de la aplicación
NG_APP_VERSION=1.0.0